<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
	<metadata>
		<id>%NAME%</id>
		<title>%NAME%</title>
		<version>%VERSION%</version>
		<authors>ProKn1fe</authors>
		<owners></owners>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<projectUrl>https://github.com/ProKn1fe/WebView2.Runtime</projectUrl>
		<license type="file">LICENSE.txt</license>
		<readme>README.md</readme>
		<description>
			Webview2 runtime for Fixed Version distribution.

			Example usage:
			var webView = new WebView2() { Dock = DockStyle.Fill };
			await webView.EnsureCoreWebView2Async(await CoreWebView2Environment.CreateAsync(Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "WebView2")));
			Controls.Add(webView);
			webView.CoreWebView2.Navigate("https://nuget.org");
		</description>
			<dependencies>
				<dependency id="Microsoft.Web.WebView2" version="1.0.3967.48" />
				<dependency id="%NAME%.Core" version="%VERSION%" />
			</dependencies>
		<contentFiles>
			<files include="any/any/**/*.*" buildAction="none" copyToOutput="true" />
		</contentFiles>
	</metadata>
    <files>
		<file src="contentFiles\**\*.*" target="contentFiles" />
		<file src="..\README.md" target="\" />
		<file src="..\LICENSE.txt" target="\" />
    </files>
</package>
